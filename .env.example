# Auth — set both. Long random strings preferred.
ZAAL_PASSWORD=changeme-zaal
IMAN_PASSWORD=changeme-iman

# Cookie signing secret. 32+ random chars. Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-random-32-byte-hex

# GitHub write-back. Fine-grained PAT w/ contents:write on songchaindao-dot/cowork-zaodevz.
# Generate: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_REPO=songchaindao-dot/cowork-zaodevz
GITHUB_BRANCH=main

# AI chat (Assistant tab). Without MINIMAX_API_KEY the /chat page still loads
# but a send returns 503. Key is used server-side only, never sent to client.
# Get a key: https://platform.minimax.io/
MINIMAX_API_KEY=
# Optional overrides — defaults shown.
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.7
