# ─── Auth ──────────────────────────────────────────────────────
# Login passwords (leads: Zaal + Iman; worker: ThyRev)
ZAAL_PASSWORD=changeme-zaal
IMAN_PASSWORD=changeme-iman
THYREV_PASSWORD=changeme-thyrev

# Cookie signing secret — 32+ random chars
# Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-random-32-byte-hex

# ─── GitHub write-back (current backend) ───────────────────────
# Fine-grained PAT with contents:write
# Generate: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_REPO=songchaindao-dot/cowork-zaodevz
GITHUB_BRANCH=main

# ─── Supabase (Phase 2 backend) ────────────────────────────────
# Create a project at https://supabase.com, then run supabase/schema.sql
# Once set, the app switches from GitHub JSON to Supabase automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Assistant (web /chat tab + Telegram bot) ───────────────
# At least ONE provider key is required. Users can also BYOK via the chat UI.
# Default provider is set by CHAT_DEFAULT_PROVIDER (default: minimax).

# MiniMax — get from https://www.minimaxi.chat
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.7

# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Default provider for /chat when client doesn't specify: minimax|openai|claude
CHAT_DEFAULT_PROVIDER=minimax

# ─── Future ────────────────────────────────────────────────────
# Bot API key for the Hermes imanagent integration
HERMES_API_KEY=
